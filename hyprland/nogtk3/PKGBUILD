# Placeholder for the GTK3 package name. kolos is GTK-free (see CLAUDE.md
# "No Qt, no GTK"), but Arch's chromium package lists `gtk3` as a hard
# dependency even though Chromium only dlopen()s libgtk-3 if it is present and
# runs fine without it. Without this, the next `pacman -Syu` would quietly
# reinstall GTK3. Only the bare name is provided: anything depending on a
# versioned gtk3 or on the libgtk-3.so soname still fails to install, which is
# the point.
pkgname=nogtk3
pkgver=1
pkgrel=1
pkgdesc="kolos: satisfies dependencies on the gtk3 package name without installing GTK3"
arch=('any')
license=('0BSD')
provides=('gtk3')
conflicts=('gtk3')

package() {
    :
}
