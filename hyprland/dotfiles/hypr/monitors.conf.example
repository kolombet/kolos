# Per-machine monitor layout and workspace-to-monitor bindings.
# Copy this file to monitors.conf (same directory) and edit for the
# current machine — monitors.conf is gitignored on purpose.

# --- Single virtual/HiDPI display (e.g. VM guest) ---
# monitor=,preferred,auto,2
# monitor=,3024x1964@60,0x0,2

# --- Two-monitor desktop example ---
# monitor=DP-1,3840x2160@60,0x0,2
# monitor=HDMI-A-1,3840x2160@30,1920x1080,2
# monitor=HDMI-A-1,2560x1440@59.95,2560x0,1
# monitor=HDMI-A-1,2560x1440@59.95,2560x0,1.6
# monitor=HDMI-A-1,1920x1080@60,1920x0,1
#
# workspace = 1, monitor:DP-1
# workspace = 2, monitor:DP-1
# workspace = 3, monitor:DP-1
# workspace = 4, monitor:DP-1
# workspace = 5, monitor:HDMI-A-1
