# Trimmed from Arch's libutf8proc PKGBUILD; see ../README.md.
pkgname=libutf8proc
pkgver=2.12.0
pkgrel=1
pkgdesc='C library for processing UTF-8 encoded Unicode strings'
arch=(x86_64 aarch64)
url=https://github.com/JuliaStrings/utf8proc
license=(MIT)
depends=(glibc)
makedepends=(cmake)
source=("utf8proc-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('f564011d38b2888d583d510b08e69ffa15aa117155db1b9b49ef1dfe1fa25111')

build() {
  cmake -B build -S "utf8proc-$pkgver" -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib -DBUILD_SHARED_LIBS=ON
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/" "utf8proc-$pkgver/LICENSE.md"
}
